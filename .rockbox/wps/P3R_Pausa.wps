# ---------------------------------------------------------------- datos de la pista
%V(150,67,166,26,2)%Vf(ffffff)
%s%?it<%it|%fn>
%V(150,98,166,17,3)%Vf(9ee8ff)
%s%?ia<%ia|%?iA<%iA|Unknown>>

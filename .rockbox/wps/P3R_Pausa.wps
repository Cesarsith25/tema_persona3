# ---------------------------------------------------------------- portada
%V(18,62,116,116,-)
%?C<%Cd|%xd(noart)>
#
# ---------------------------------------------------------------- estado
%V(266,45,14,14,-)
%?mp<%xd(stop)|%xd(play)|%xd(pausa)|%xd(ffw)|%xd(rew)>

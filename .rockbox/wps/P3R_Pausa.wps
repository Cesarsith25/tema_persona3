# Persona 3 Reload - "Menu de pausa"  (WPS: pantalla de reproduccion)
# Innioasis Y1 - Rockbox 240p (320x240, perfil iPod Classic / ipod6g)
# HP = progreso de la cancion, SP = volumen
#
%wd
%X(fondo_wps.bmp)
%Fl(2,23-P3R-Menu.fnt)
%Fl(3,15-P3R-Texto.fnt)
%Fl(4,11-P3R-Mini.fnt)

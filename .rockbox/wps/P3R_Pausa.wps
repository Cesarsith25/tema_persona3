%xl(pausa,ico_pausa.bmp,0,0)
%xl(stop,ico_stop.bmp,0,0)
%xl(ffw,ico_ff.bmp,0,0)
%xl(rew,ico_rew.bmp,0,0)
%Cl(0,0,116,116,c,c)
#
%?if(%ck,=,0)<%Vd(oscura)|%Vd(hora)>
#
# ---------------------------------------------------------------- fecha
%V(4,5,74,26,2)%Vf(ffffff)
%cm/%cd
%V(90,3,70,17,3)%Vf(ffffff)
%ca
%Vl(hora,89,19,68,13,4)%Vf(3cc8ff)
